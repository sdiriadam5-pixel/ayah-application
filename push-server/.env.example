# PWA public HTTPS origin, without a subpath or trailing slash
APP_ORIGIN=https://your-site.example
# Optional contact for push-service VAPID metadata
VAPID_SUBJECT=mailto:you@example.com
PORT=8080
# MUST be a persistent volume in production; stores VAPID keypair and subscriptions
DATA_DIR=./data
# Optional: supply both VAPID keys, or omit both to auto-generate on the persistent volume.
# Never commit an actual private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
